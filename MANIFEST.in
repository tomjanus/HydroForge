include README.md
include LICENSE
include requirements.txt
include setup.cfg
include *.yaml
include *.yml

# Include configuration files
include user_configuration*.yalm
include config.yaml

# Include input data files
recursive-include inputs *.inp
recursive-include original_networks *.inp

# Include Cython source files
recursive-include cython *.pyx *.c *.py

# Include test files
recursive-include tests *.py

# Exclude build artifacts and outputs
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude __pycache__
global-exclude .DS_Store
prune build
prune dist
prune *.egg-info
prune outputs
prune test_outputs
prune intermediates
prune .git
